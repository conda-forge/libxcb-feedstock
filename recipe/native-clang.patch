Use the Clang GNU driver with MSVC-style libtool exports and the X11
Windows header wrappers. Header fixes follow the Windows portability fixes
in microsoft/vcpkg ports/libxcb (use_xwindows_includes and getpid_include).
Both the generated configure and its macro sources are kept consistent.
This patch is applied only to the native Windows ARM64 build.

--- a/configure
+++ b/configure
@@ -11540,7 +11540,7 @@
             cp "$export_symbols" "$output_objdir/$soname.def";
             echo "$tool_output_objdir$soname.def" > "$output_objdir/$soname.exp";
           else
-            $SED -e '\''s/^/-link -EXPORT:/'\'' < $export_symbols > $output_objdir/$soname.exp;
+            $SED -e '\''s/^/-Xlinker -EXPORT:/'\'' < $export_symbols > $output_objdir/$soname.exp;
           fi~
           $CC -o $tool_output_objdir$soname $libobjs $compiler_flags $deplibs "@$tool_output_objdir$soname.exp" -Wl,-DLL,-IMPLIB:"$tool_output_objdir$libname.dll.lib"~
           linknames='
@@ -21543,7 +21543,7 @@
 case $host_os in
 mingw*)
         have_win32="yes"
-        lt_enable_auto_import="-Wl,--enable-auto-import"
+        lt_enable_auto_import="" # LLD uses explicit MSVC DLL imports, not GNU auto-import.
         ;;
 linux*)
 
--- a/m4/libtool.m4
+++ b/m4/libtool.m4
@@ -5610,7 +5610,7 @@
             cp "$export_symbols" "$output_objdir/$soname.def";
             echo "$tool_output_objdir$soname.def" > "$output_objdir/$soname.exp";
           else
